# Development Environment Variables
# Copy this file to .env and modify as needed

# Supabase Configuration
# Get these values from your Supabase project dashboard:
# https://supabase.com/dashboard

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Sheets configuration
# Required: spreadsheet that supplies dashboard data
GOOGLE_SHEET_ID=1op7Xox8ZNi3WoIX4zfn88O_HR8yHbZXQ4iih5HfL7Yo
# Optional: expose the ID to client components if needed
# NEXT_PUBLIC_GOOGLE_SHEET_ID=

# Google Service Account (required for CRUD access)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key exactly as exported, or escape newlines with \n
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\nYOUR-PRIVATE-KEY\n-----END PRIVATE KEY-----\n"

# Optional: For development debugging
# DEBUG=supabase:*
